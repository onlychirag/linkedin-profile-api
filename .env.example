# Optional API protection for public deployments.
API_KEY=

# Preferred production method: let the backend create and refresh its own session.
LINKEDIN_EMAIL=
# LINKEDIN_USERNAME is accepted as an alias for LINKEDIN_EMAIL.
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
PROXY_URL=

# Alternative local method: run scripts/create_linkedin_session.py and mount this file.
LINKEDIN_USER_DATA_DIR=.auth/linkedin-browser-profile
LINKEDIN_STORAGE_STATE_PATH=.auth/linkedin-state.json

# Alternative hosted method: base64 of the Playwright storage-state JSON file.
LINKEDIN_STORAGE_STATE_B64=

ENABLE_BROWSER_SCRAPER=true
ENABLE_AUTH_HTTP_SCRAPER=true
BROWSER_BACKEND=auto
ENABLE_DRISSION_SCRAPER=true
PLAYWRIGHT_HEADLESS=true
DRISSION_HEADLESS=true
DRISSION_BROWSER_PATH=
SCRAPER_USER_AGENT=
BROWSER_USER_AGENT=
REQUEST_TIMEOUT_MS=45000
ALLOWED_ORIGINS=*
