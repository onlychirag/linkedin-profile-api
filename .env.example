# ──────────────────────────────────────────
# LinkedIn Profile API — Environment Config
# ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# REQUIRED: Your LinkedIn session cookie.
# How to get it:
#   1. Open Chrome → go to linkedin.com → log in
#   2. Press F12 → Application tab → Cookies → linkedin.com
#   3. Copy the value of the cookie named 'li_at'
LI_AT_COOKIE=paste_your_li_at_cookie_here

# OPTIONAL: Your LinkedIn JSESSIONID cookie (used for CSRF token).
# Found in the same cookies panel. Remove surrounding double-quotes.
JSESSIONID=

# OPTIONAL: Rate limiting (seconds between requests)
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=5.0

# OPTIONAL: Application settings
APP_ENV=development
LOG_LEVEL=INFO
